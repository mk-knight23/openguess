{
  "name": "openguess",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "A free, open-source, explainable character guessing game.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run validate:playable && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && node scripts/smoke.mjs",
    "format": "prettier --write src scripts docs *.json *.ts *.html *.md .github",
    "format:check": "prettier --check src scripts docs *.json *.ts *.html *.md .github",
    "validate:playable": "node scripts/validate-playable-manifests.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "volta": {
    "node": "24.19.0"
  }
}
